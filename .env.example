# Copy this file to `.env` and fill in your own key.
# NEVER commit the real file — `.env` is git-ignored.
#
#   cp .env.example .env
#   export OPENROUTER_API_KEY=...        # or: set -a; . ./.env; set +a
#
# The key is read at runtime and is never written to disk or to any result file.

OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://github.com/deghosal-2026/llm-persona-probe
